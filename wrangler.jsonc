{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lingua",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "lingua.hakanalpay.com",
      "custom_domain": true
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "46101",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "USAGE"
    },
    {
      "binding": "EXERCISES"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-sol",
    "MAX_DAILY_AI_UNITS": "120"
  }
}
